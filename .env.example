# Anthropic (Claude) API Configuration (used for grounded answer generation)
# Get your Anthropic API Key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override the default generation model
ANTHROPIC_MODEL=claude-sonnet-5

# Pinecone Configuration
# Get your Pinecone API Key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here
# Used only if the index doesn't exist yet and needs to be auto-created
# (serverless free tier is aws/us-east-1 only).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Number of chunks retrieved from Pinecone per query.
# Optional override — defaults to RETRIEVAL_TOP_K in src/ingest/config.py (5).
RETRIEVER_TOP_K=5

# Embeddings are generated locally with sentence-transformers (all-MiniLM-L6-v2,
# 384-dim) — no API key or cost. No config needed here.

# Non-secret ingestion tunables (fetch limit, date range, topics, publication
# type filters, population keywords) live as named constants in
# src/ingest/config.py, not here.

# PubMed / NCBI E-utilities Configuration (used by the ingestion pipeline)
# NCBI requests a contact email and tool name for API etiquette; no account is required.
# An API key is optional but raises the rate limit from 3 req/s to 10 req/s:
# https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_EMAIL=
PUBMED_API_KEY=
PUBMED_TOOL=diabevidence

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
